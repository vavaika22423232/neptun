{
  "name": "nextjs-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "designpack:sync-css": "cp ../designpack/src/styles/tailadmin.css src/styles/tailadmin.css",
    "quality:gold": "cd worker && python3 -m unittest tests.test_gold_parser -v",
    "dev": "next dev --webpack",
    "dev:turbo": "next dev",
    "build": "next build",
    "postbuild": "cp -r .next/static .next/standalone/.next/static && cp -r public .next/standalone/public",
    "start": "next start",
    "lint": "eslint",
    "test:domain": "tsx src/lib/__tests__/domain-contract.test.ts && tsx src/lib/__tests__/public-marker-policy.test.ts && tsx src/lib/__tests__/target-tracker-engine.test.ts && tsx src/lib/__tests__/map-alarm-svg-renderer.test.ts && tsx src/lib/__tests__/track-estimator.test.ts && tsx src/lib/__tests__/chat-ban-service.test.ts && tsx src/lib/__tests__/ekf.test.ts && tsx src/lib/__tests__/ekf-tracker-integration.test.ts && tsx src/lib/__tests__/drone-tracker-renderer.test.ts && tsx src/lib/__tests__/tracker-plan-v2.test.ts && tsx src/lib/__tests__/places-search.test.ts && tsx src/lib/__tests__/security-hardening.test.ts",
    "validate:map-svg": "tsx scripts/validate-map-svg-contract.ts",
    "ingest:checklist": "tsx scripts/run-ingest-smoke.ts --checklist",
    "ingest:smoke": "tsx scripts/run-ingest-smoke.ts",
    "ingest:smoke:pair": "tsx scripts/run-ingest-smoke.ts --pair",
    "threat-ws": "tsx src/server/realtime-ws-server.ts"
  },
  "dependencies": {
    "@fastify/websocket": "^11.2.0",
    "@googleapis/androidpublisher": "^35.3.0",
    "@mapbox/vector-tile": "^2.0.4",
    "@maplibre/maplibre-gl-leaflet": "^0.1.3",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fastify": "^5.8.5",
    "ioredis": "^5.9.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.14.0",
    "maplibre-gl": "^5.17.0",
    "next": "16.1.6",
    "node-apple-receipt-verify": "^1.15.0",
    "pbf": "^4.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-leaflet": "^5.0.0",
    "tailwind-merge": "^3.5.0",
    "ws": "^8.20.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@turf/turf": "^7.3.5",
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
