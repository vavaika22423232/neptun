{
  "name": "nextjs-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "designpack:sync-css": "cp ../designpack/src/styles/tailadmin.css src/styles/tailadmin.css",
    "quality:gold": "cd worker && python3 -m unittest tests.test_gold_parser -v",
    "dev": "next dev --webpack",
    "dev:turbo": "next dev",
    "build": "next build",
    "postbuild": "cp -r .next/static .next/standalone/.next/static && cp -r public .next/standalone/public",
    "start": "next start",
    "lint": "eslint",
    "ingest:checklist": "tsx scripts/run-ingest-smoke.ts --checklist",
    "ingest:smoke": "tsx scripts/run-ingest-smoke.ts",
    "ingest:smoke:pair": "tsx scripts/run-ingest-smoke.ts --pair"
  },
  "dependencies": {
    "@googleapis/androidpublisher": "^35.3.0",
    "@maplibre/maplibre-gl-leaflet": "^0.1.3",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.6.2",
    "ioredis": "^5.9.3",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^5.17.0",
    "next": "16.1.6",
    "node-apple-receipt-verify": "^1.15.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-leaflet": "^5.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
