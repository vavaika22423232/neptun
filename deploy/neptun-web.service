[Unit]
Description=Neptun Next.js Web Service (PM2 via pm2-runtime)
After=network.target redis-server.service
StartLimitBurst=15
StartLimitIntervalSec=120

[Service]
# pm2-runtime не демонізується — systemd не вважає сервіс «мертвим» після bash, на відміну від Type=forking + pm2 start
Type=simple
User=neptun
Group=neptun
WorkingDirectory=/home/neptun/app
EnvironmentFile=/home/neptun/app/.env
Environment=PM2_HOME=/home/neptun/.pm2
Environment=GOOGLE_APPLICATION_CREDENTIALS=/home/neptun/keys/play-purchase-verifier.json
Environment=GOOGLE_PLAY_PACKAGE_NAME=com.neptunalarm.neptun_alarm_app

ExecStartPre=/usr/bin/test -f /home/neptun/app/.env

LimitNOFILE=65535

ExecStart=/bin/bash -lc 'set -a && source /home/neptun/app/.env && set +a && exec /usr/bin/pm2-runtime start /home/neptun/app/ecosystem.config.cjs'

ExecReload=/bin/bash -lc 'set -a && source /home/neptun/app/.env && set +a; /usr/bin/pm2 reload neptun --update-env'

KillSignal=SIGINT
TimeoutStopSec=90
Restart=always
RestartSec=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=neptun-web

NoNewPrivileges=true
PrivateTmp=true

# PM2 cluster (несколько next-server): 5G раніше тиснуло на cgroup → OOM/thrash і «замерзлі» воркери → 502.
MemoryMax=16384M

[Install]
WantedBy=multi-user.target
