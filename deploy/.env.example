# ╔══════════════════════════════════════════════════════════════════╗
# ║  Neptun Environment Variables — Template                        ║
# ║                                                                  ║
# ║  Copy to /home/neptun/app/.env and fill in real values           ║
# ║  This file is NEVER deployed/overwritten by rsync (excluded)     ║
# ║  Backups are auto-created at /home/neptun/backups/               ║
# ╚══════════════════════════════════════════════════════════════════╝

# ── Node.js / Next.js ────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ── Data Storage ─────────────────────────────────────────────────
# Directory for messages.json, trajectory_learning.json, feedback.db
DATA_DIR=/data

# ── Authentication ───────────────────────────────────────────────
# Secret for API auth (used by ingest endpoint, shared with worker)
AUTH_SECRET=CHANGE_ME_TO_A_RANDOM_STRING

# Admin panel password
ADMIN_PASSWORD=CHANGE_ME

# ── Alarm API ────────────────────────────────────────────────────
# API key for ukrainealarm.com (format: client_id:secret_key)
ALARM_API_KEY=CHANGE_ME

# ── Firebase (Push Notifications) ────────────────────────────────
# Path to Firebase service account JSON file on disk
# ⚠ DO NOT use FIREBASE_CREDENTIALS_BASE64 — it breaks in systemd EnvironmentFile
#   (line too long, private key gets corrupted)
# Instead, place the JSON file on the server and reference it here:
FIREBASE_CREDENTIALS_FILE=/home/neptun/app/worker/firebase-credentials.json

# ── Telegram Worker ──────────────────────────────────────────────
# Telegram API credentials (from https://my.telegram.org)
TELEGRAM_API_ID=CHANGE_ME
TELEGRAM_API_HASH=CHANGE_ME

# Telethon StringSession — generated by running:
#   /home/neptun/app/venv/bin/python /tmp/gen_session.py
# This is a long single-line string. Do NOT wrap or split it.
TELEGRAM_SESSION=CHANGE_ME

# ── Worker → Web Communication ───────────────────────────────────
# URL for worker to push markers to the Next.js ingest endpoint
INGEST_URL=http://127.0.0.1:3000/api/ingest

# ── Geocoding (optional) ─────────────────────────────────────────
# VISICOM_API_KEY=
# OPENCAGE_API_KEY=

# ── Python ───────────────────────────────────────────────────────
# Ensure Python output is not buffered (visible in journalctl immediately)
PYTHONUNBUFFERED=1
