[Unit]
Description=Neptun Telegram Worker (Python)
After=network.target neptun-web.service
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
Type=simple
User=neptun
Group=neptun
WorkingDirectory=/home/neptun/app/worker
EnvironmentFile=/home/neptun/app/.env
Environment=TZ=Europe/Kyiv

# Don't start without .env and venv
ExecStartPre=/usr/bin/test -f /home/neptun/app/.env
ExecStartPre=/usr/bin/test -f /home/neptun/venv/bin/python

# Worker opens many concurrent aiohttp/Telegram handles during bursts — default 1024 FDs causes
# "Too many open files", failed ingest to :3000, and broken retry queue writes (errno 24).
LimitNOFILE=65535

ExecStart=/home/neptun/venv/bin/python worker.py
Restart=always
RestartSec=10

# Graceful shutdown — give Telegram time to disconnect
TimeoutStopSec=30
KillMode=mixed
KillSignal=SIGTERM

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=neptun-worker

# Security
NoNewPrivileges=true
PrivateTmp=true

# Memory limit
MemoryMax=1G

[Install]
WantedBy=multi-user.target
