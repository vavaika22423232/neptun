{
  "name": "neptun_expo_app",
  "version": "2.1.1",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "start:go": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "android:go": "expo start --android",
    "ios:go": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test:navigation": "npx tsx src/core/navigation/navigationParity.test.ts",
    "test:api": "npx tsx src/services/apiHttp.test.ts",
    "test:core": "npx tsx src/core/pro/proGate.test.ts && npx tsx src/theme/themeStorage.test.ts && npx tsx src/features/chat/logic/chatMessageValidation.test.ts",
    "test:radar": "npx tsx src/features/radar/data/radarRepository.test.ts && npx tsx src/features/radar/logic/groupThreatMarkers.test.ts",
    "test:heatmap": "npx tsx src/features/heatmap/logic/heatmapAggregate.test.ts",
    "test:map-motion": "npx tsx src/features/map/engine/markerMotionEngine.test.ts",
    "test:map-geo": "npx tsx src/features/map/utils/districtGeoLoader.test.ts",
    "test:widgets": "npx tsx src/features/widgets/utils/countThreatTypes.test.ts",
    "test:notifications": "npx tsx src/features/notifications/utils/regionToTopic.test.ts && npx tsx src/features/notifications/logic/fcmMessagePipeline.test.ts && npx tsx src/features/notifications/logic/formatTtsMessage.test.ts",
    "sync:map-geo": "cp assets/geo/ukraine_oblasts.geojson src/features/map/data/ukraine_oblasts.json && cp assets/geo/ukraine_districts.geojson src/features/map/data/ukraine_districts.json"
