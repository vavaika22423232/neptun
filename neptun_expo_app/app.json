{
  "expo": {
    "name": "Dron Alerts",
    "slug": "neptun",
    "version": "2.1.1",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "scheme": "neptun",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#070A12"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.neptunalarm.neptunAlarmApp",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.neptunalarm.neptun_alarm_app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#070A12"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "POST_NOTIFICATIONS",
        "ACCESS_NETWORK_STATE",
        "WAKE_LOCK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withNeptunHomeWidget.js",
      "expo-dev-client",
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      "expo-updates",
      [
        "@rnmapbox/maps",
        {
          "RNMapboxMapsDownloadToken": ""
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      "expo-iap",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-1995509849440582~8995763934",
          "iosAppId": "ca-app-pub-1995509849440582~7835319378"
        }
      ],
      "expo-audio",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Дозвіл на геолокацію для пошуку найближчих укриттів."
        }
      ]
    ],
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "extra": {
      "apiBaseUrl": "https://neptun.in.ua",
      "mapboxAccessToken": "",
      "eas": {
        "projectId": "00000000-0000-0000-0000-000000000000"
      }
    }
  }
}
